__pycache__/
*.pyc
.pytest_cache/
.venv/
*.sqlite
*.db
# Held-out evaluation data is regenerated on demand
output/holdout_seed*/
# Graph file is rebuilt in ~2s by python -m veritas.graph; reports next to it are committed
output/phase3/graph.graphml
# The audit database (*.sqlite, above) and its anchor are rebuilt with the graph; the anchor's hash changes every build
output/phase5/anchor.json
# Browser-check logs written by the Playwright tool
.playwright-mcp/
# Frontend dependencies and build output (npm install and npm run build recreate them)
node_modules/
frontend/dist/
# Design-skill working files (surface brief, review captures); DESIGN.md is the committed record
.impeccable/
